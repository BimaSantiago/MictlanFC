# Copia este archivo a .env y completa los valores. .env NUNCA se commitea.

# API key de Gemini (Google AI Studio)
GEMINI_API_KEY=

# Modelo de Gemini a usar para generar/auditar contratos.
GEMINI_MODEL=gemini-3.5-flash-lite

# Orígenes permitidos para CORS, separados por coma. "*" solo para demo/desarrollo.
ALLOWED_ORIGINS=*

# Identidad de Stellar CLI usada para compilar/desplegar/invocar en testnet.
STELLAR_SOURCE_IDENTITY=alice

# Máximo de requests por IP dentro de la ventana de rate limit.
RATE_LIMIT_MAX_REQUESTS=5

# Duración de la ventana de rate limit, en segundos.
RATE_LIMIT_WINDOW_SECONDS=600
